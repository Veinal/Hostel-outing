generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  WARDEN
  CHIEF_WARDEN
  ADMIN
  SECURITY
}

enum RequestType {
  OUTING
  HOME_GOING
  OTHERS
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  OVERDUE
}

enum CertificateStatus {
  ACTIVE
  STEPPED_OUT
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ScanType {
  EXIT
  ENTRY
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  DELAY_FLAGGED
  OVERDUE_ALERT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            Role
  fullName        String
  phone           String?
  usn             String?   @unique
  isn             String?
  parentPhone     String?
  year            String?
  branch          String?
  gender          String?
  photoUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  room            Room?     @relation(fields: [roomId], references: [id])
  roomId          String?
  wardenOf        Block[]   @relation("WardenBlock")
  requestsAsStudent OutingRequest[] @relation("StudentRequests")
  requestsAsWarden  OutingRequest[] @relation("WardenRequests")
  scanLogs        ScanLog[]
  notifications   Notification[]

  @@index([role])
  @@index([usn])
}

model Block {
  id        String  @id @default(uuid())
  name      String  @unique   // e.g. "A", "B", "M", "F"
  gender    String            // "BOYS" | "GIRLS"
  floors    Floor[]
  warden    User?   @relation("WardenBlock", fields: [wardenId], references: [id])
  wardenId  String?
}

model Floor {
  id        String  @id @default(uuid())
  number    Int
  block     Block   @relation(fields: [blockId], references: [id])
  blockId   String
  rooms     Room[]

  @@unique([blockId, number])
}

model Room {
  id          String  @id @default(uuid())
  roomNumber  String            // e.g. "007"
  displayName String            // e.g. "M-007"
  floor       Floor   @relation(fields: [floorId], references: [id])
  floorId     String
  students    User[]

  @@unique([floorId, roomNumber])
}

model Branch {
  id    String @id @default(uuid())
  name  String @unique     // e.g. "Computer Science"
  code  String @unique     // e.g. "CSE"
}

model OutingRequest {
  id              String        @id @default(uuid())
  approvalNumber  String        @unique   // e.g. HO-2025-0001
  requestType     RequestType
  location        String?       // Required only for OUTING
  reason          String
  status          RequestStatus @default(PENDING)
  outDateTime     DateTime
  expectedReturnDateTime DateTime
  delayFlagged    Boolean       @default(false)
  rejectionReason String?
  viaBus          Boolean       @default(false)

  student         User          @relation("StudentRequests", fields: [studentId], references: [id])
  studentId       String
  warden          User          @relation("WardenRequests", fields: [wardenId], references: [id])
  wardenId        String

  certificate     ApprovalCertificate?
  notifications   Notification[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studentId])
  @@index([wardenId])
  @@index([status])
  @@index([expectedReturnDateTime])
  @@index([createdAt])
}

model ApprovalCertificate {
  id              String              @id @default(uuid())
  qrToken         String              @unique  // Signed JWT token
  status          CertificateStatus   @default(ACTIVE)
  approvedAt      DateTime            @default(now())
  exitScannedAt   DateTime?
  entryScannedAt  DateTime?

  request         OutingRequest       @relation(fields: [requestId], references: [id])
  requestId       String              @unique
  scanLogs        ScanLog[]
}

model ScanLog {
  id              String      @id @default(uuid())
  scanType        ScanType
  scannedAt       DateTime    @default(now())
  deviceId        String?
  ipAddress       String?

  certificate     ApprovalCertificate @relation(fields: [certificateId], references: [id])
  certificateId   String
  scannedBy       User        @relation(fields: [scannedById], references: [id])
  scannedById     String
}

model Notification {
  id          String            @id @default(uuid())
  type        NotificationType
  channel     String            // "EMAIL" | "SMS" | "IN_APP"
  recipient   String            // email or phone
  payload     Json
  sentAt      DateTime?
  error       String?
  createdAt   DateTime          @default(now())

  user        User?             @relation(fields: [userId], references: [id])
  userId      String?
  request     OutingRequest?    @relation(fields: [requestId], references: [id])
  requestId   String?
}

model AuditLog {
  id          String    @id @default(uuid())
  action      String    // e.g. "REQUEST_APPROVED"
  entityType  String    // e.g. "OutingRequest"
  entityId    String
  performedBy String    // User ID
  metadata    Json?
  createdAt   DateTime  @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
